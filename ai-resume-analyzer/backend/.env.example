# Server
PORT=5000

# Database
DB_NAME=resume_analyzer

# Auth - MUST be set. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# AI provider ensemble -----------------------------------------------
# Which providers to run. Leave empty to auto-enable every provider
# that has an API key set below. Options (comma-separated):
#   gemini, openai, anthropic
# Example: AI_PROVIDERS=gemini,openai
AI_PROVIDERS=

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
# Extra Gemini models to include in the ensemble (comma-separated),
# e.g. gemini-3.6-pro
GEMINI_MODELS=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: comma-separated allow-list of frontend origins.
# If unset, the API accepts requests from any origin (bearer-token auth).
# e.g. https://your-app.vercel.app,http://localhost:3000
CLIENT_URL=http://localhost:3000

# Set to 'production' to serve the built frontend statically
NODE_ENV=development
